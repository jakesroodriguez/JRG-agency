{
  "buildCommand": "npm --prefix \"1-Web/01_💻_Codigo_Web\" run build",
  "outputDirectory": "1-Web/01_💻_Codigo_Web/dist",
  "installCommand": "npm --prefix \"1-Web/01_💻_Codigo_Web\" install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
